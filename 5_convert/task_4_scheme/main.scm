(use-modules (srfi srfi-1))

(define (digit? character)
  (and (char? character) (char<=? #\0 character #\9)))

(define (identifier-start? character)
  (and (char? character) (or (char-alphabetic? character) (char=? character #\_))))

(define (read-while input predicate)
  (let loop ((characters '()))
    (let ((character (peek-char input)))
      (if (predicate character)
          (begin (read-char input) (loop (cons character characters)))
          (list->string (reverse characters))))))

(define (read-quoted input delimiter)
  (let loop ((characters '()))
    (let ((character (read-char input)))
      (cond
        ((eof-object? character) (error "Unterminated quoted text"))
        ((char=? character delimiter)
         (if (eqv? (peek-char input) delimiter)
             (begin (read-char input) (loop (cons delimiter characters)))
             (list->string (reverse characters))))
        (else (loop (cons character characters)))))))

(define (next-token input)
  (let skip ()
    (let ((character (peek-char input)))
      (if (and (char? character) (char-whitespace? character))
          (begin (read-char input) (skip)))))
  (let ((character (peek-char input)))
    (cond
      ((eof-object? character) (cons 'eof #f))
      ((identifier-start? character)
       (cons 'identifier
             (read-while input (lambda (value) (or (identifier-start? value) (digit? value))))))
      ((or (digit? character) (memv character '(#\+ #\-)))
       (let* ((sign (if (digit? character) "" (string (read-char input))))
              (digits (read-while input digit?)))
         (when (string-null? digits) (error "Expected digits after sign"))
         (cons 'number (string-append sign digits))))
      ((char=? character #\')
       (read-char input) (cons 'string (read-quoted input #\')))
      ((char=? character #\")
       (read-char input) (cons 'quoted-identifier (read-quoted input #\")))
      ((memv character '(#\( #\) #\, #\; #\.))
       (read-char input) (cons 'punctuation character))
      (else (error "Unexpected character" character)))))

(define (write-csv fields output)
  (let loop ((remaining fields) (first #t))
    (unless (null? remaining)
      (unless first (write-char #\, output))
      (let ((field (car remaining)))
        (case (car field)
          ((string)
           (write-char #\" output)
           (string-for-each
             (lambda (character)
               (if (char=? character #\") (display "\"\"" output) (write-char character output)))
             (cdr field))
           (write-char #\" output))
          ((number) (display (cdr field) output))
          ((null) #t)))
      (loop (cdr remaining) #f)))
  (display "\r\n" output))

(define (convert input output)
  (let ((cached #f) (table #f) (header #f) (count 0))
    (define (peek-token)
      (unless cached (set! cached (next-token input)))
      cached)
    (define (take-token)
      (let ((token (peek-token))) (set! cached #f) token))
    (define (accept character)
      (let ((token (peek-token)))
        (and (eq? (car token) 'punctuation) (eqv? (cdr token) character)
             (begin (take-token) #t))))
    (define (expect character)
      (unless (accept character) (error "Expected punctuation" character)))
    (define (keyword word)
      (let ((token (take-token)))
        (unless (and (eq? (car token) 'identifier) (string-ci=? (cdr token) word))
          (error "Expected keyword" word))))
    (define (identifier)
      (let ((token (take-token)))
        (case (car token)
          ((identifier) (cons (string-downcase (cdr token)) (cdr token)))
          ((quoted-identifier) (cons (cdr token) (cdr token)))
          (else (error "Expected an identifier")))))
    (define (table-name)
      (let loop ((parts (list (car (identifier)))))
        (if (accept #\.) (loop (cons (car (identifier)) parts)) (reverse parts))))
    (define (columns)
      (expect #\()
      (let loop ((items (list (identifier))))
        (if (accept #\,)
            (loop (cons (identifier) items))
            (begin (expect #\)) (reverse items)))))
    (define (value)
      (let ((token (take-token)))
        (cond
          ((memq (car token) '(number string)) token)
          ((and (eq? (car token) 'identifier) (string-ci=? (cdr token) "NULL")) (cons 'null #f))
          (else (error "Expected integer, string or NULL")))))
    (define (row)
      (expect #\()
      (let loop ((items (list (value))))
        (if (accept #\,)
            (loop (cons (value) items))
            (begin (expect #\)) (reverse items)))))
    (let statements ()
      (if (eq? (car (peek-token)) 'eof)
          (unless header (error "Expected at least one INSERT"))
          (begin
            (keyword "INSERT")
            (keyword "INTO")
            (let* ((current-table (table-name))
                   (current-columns (columns))
                   (keys (map car current-columns)))
              (unless (= (length keys) (length (delete-duplicates keys string=?)))
                (error "Duplicate column names"))
              (if header
                  (unless (and (equal? table current-table)
                               (= (length header) (length keys))
                               (every (lambda (item) (member (car item) keys string=?)) header))
                    (error "All INSERT statements must use the same table and columns"))
                  (begin
                    (set! table current-table)
                    (set! header current-columns)
                    (write-csv (map (lambda (item) (cons 'string (cdr item))) header) output)))
              (keyword "VALUES")
              (let ((positions
                     (map (lambda (item) (list-index (lambda (key) (string=? key (car item))) keys)) header)))
                (let rows ()
                  (let ((values (row)))
                    (unless (= (length values) (length keys)) (error "Column/value count mismatch"))
                    (write-csv (map (lambda (position) (list-ref values position)) positions) output)
                    (set! count (+ count 1)))
                  (when (accept #\,) (rows)))))
            (unless (or (accept #\;) (eq? (car (peek-token)) 'eof))
              (error "Expected semicolon between INSERT statements"))
            (statements))))
    count))

(define (run arguments)
  (unless (= (length arguments) 2) (error "Usage: guile -s main.scm <input.sql> <output.csv>"))
  (let* ((temporary (string-append (cadr arguments) ".tmp.XXXXXX"))
         (output (mkstemp! temporary)))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (set-port-encoding! output "UTF-8")
        (let ((count (call-with-input-file (car arguments)
                       (lambda (input)
                         (set-port-encoding! input "UTF-8")
                         (convert input output)))))
          (close-port output)
          (rename-file temporary (cadr arguments))
          (format #t "Converted: ~a~%" count)))
      (lambda ()
        (unless (port-closed? output) (close-port output))
        (when (file-exists? temporary) (delete-file temporary))))))

(catch #t
  (lambda () (run (cdr (command-line))))
  (lambda (key . arguments)
    (format (current-error-port) "Error: ~a ~s~%" key arguments)
    (exit 1)))
